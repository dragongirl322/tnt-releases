# Postgres connection. Leave unset to use a local SQLite file.
# Railway: reference the Postgres plugin, e.g. ${{Postgres.DATABASE_URL}}
DATABASE_URL=

# Optional shared floor PIN. Leave unset to leave the board open.
STORE_PIN=

# SQLite file used only when DATABASE_URL is not a Postgres URL.
SQLITE_PATH=./data/tnt.sqlite

# Railway sets PORT. Local default is 3000.
PORT=3000
